{
  "name": "gunner",
  "version": "0.47.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run generate:fitting-db && astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "postinstall": "astro sync",
    "typecheck": "tsc --noEmit",
    "test": "bun run scripts/test-parallel.ts",
    "e2e": "playwright test",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "trace": "bun run scripts/sim-trace.ts",
    "generate:icons": "bun run scripts/generate-icon-assets.ts",
    "generate:slots": "bun run scripts/generate-module-slots.ts",
    "generate:name-i18n": "bun run scripts/generate-name-i18n.ts",
    "generate:fitting-db": "bun run scripts/generate-fitting-db.ts",
    "generate:fitting-presets": "bun run scripts/generate-fitting-presets.ts",
    "validate:fittings": "bun run scripts/validate-fittings.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "awilix": "13.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "astro": "7.3.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2"
  }
}

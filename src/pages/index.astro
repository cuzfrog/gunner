---
import Layout from "../layouts/Layout.astro";
import pkg from "../../package.json";
import { AppHeader, AppFooter, AppIntro, ProfileBar, ResultGrid, ShipPanel, CanvasFrame } from "../components";

const version = pkg.version;
---

<Layout
  title="EVE Online Combat Simulator — Gunner"
  description="EVE Online combat simulator. Simulate ship-vs-ship fights in your browser with real-time movement, tracking, damage application and capacitor warfare."
>
  <div class="app-container">
    <AppHeader version={version} />
    <ProfileBar />
    <ResultGrid />
    <main class="app-main">
      <ShipPanel side="shipA" />
      <CanvasFrame />
      <ShipPanel side="shipB" />
    </main>
    <AppIntro />
    <AppFooter />
  </div>

  <datalist id="hull-options"></datalist>
</Layout>

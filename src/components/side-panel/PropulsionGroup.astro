---
import { DEFAULT_VALUES } from "../../ui/controls";
import type { Side } from "../../ui/controls";
import InputWithUnit from "../form/InputWithUnit.astro";

interface Props {
  readonly idPrefix: string;
  readonly side: Side;
}
const { idPrefix, side } = Astro.props;
const speed = DEFAULT_VALUES[`${idPrefix}-speed`];
---

<div class="form-field-group propulsion-group">
  <span class="field-label truncate" data-i18n="label.maxSpeed">Max speed</span>
  <select class="input-field" id={`${idPrefix}-propulsion`} hidden disabled></select>
  <div class="propulsion-selector-wrapper">
    <div class="segmented-control propulsion-selector" id={`${idPrefix}-propulsion-options`} role="group" data-i18n-aria-label="label.propulsion" aria-label="Propulsion"></div>
    <button type="button" id={`${idPrefix}-propulsion-gear`} class="propulsion-gear btn icon-button" data-i18n-title="label.propulsionVariant" data-i18n-aria-label="label.propulsionVariant" aria-haspopup="menu" aria-expanded="false" aria-controls={`${idPrefix}-propulsion-variants`} disabled>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><use href="icons.svg#gear"></use></svg>
    </button>
    <div class="fitting-popup propulsion-variants-popup popup popup-below popup-right popup-scroll" id={`${idPrefix}-propulsion-variants`} role="menu" hidden data-i18n-aria-label="label.propulsionVariant" aria-label="Select propulsion variant"></div>
  </div>
  <button type="button" id={`${idPrefix}-overload-button`} class="overload-button btn" data-i18n-aria-label="label.overload" data-i18n-title="label.overload" aria-pressed="true">
    <svg class="overload-button-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><use href="icons.svg#overload"></use></svg>
  </button>
  <InputWithUnit id={`${idPrefix}-speed`} value={speed} min="0" extraClass="input-with-unit-has-effective" effectiveId={`effective-${idPrefix}-speed`} i18nAriaLabel="label.maxSpeed" ariaLabel="Max speed" />
  <input type="checkbox" id={`${idPrefix}-overload`} hidden checked>
</div>

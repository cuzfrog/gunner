---
import PopupBox from "../popup/PopupBox.astro";
import TriggerButton from "../popup/TriggerButton.astro";

interface Props {
  readonly idPrefix: string;
}
const { idPrefix } = Astro.props;
---

<div class="form-field-group" id={`${idPrefix}-targeting-field`}>
  <TriggerButton id={`${idPrefix}-targeting-trigger`} popupId={`${idPrefix}-targeting-popup`}
          labelI18n="label.targeting" labelText="Targeting"
          ariaLabelI18n="label.targeting" ariaHaspopup="dialog" disabled
          ariaDescribedby={`${idPrefix}-targeting-summary-row`}>
    <span class="trigger-summary" id={`${idPrefix}-targeting-summary-row`}>
      <span id={`${idPrefix}-targeting-summary`}></span>
    </span>
  </TriggerButton>
  <PopupBox id={`${idPrefix}-targeting-popup`} extraClass="targeting-popup popup-stretch" position="below" align="both" scroll role="dialog" ariaModal={false} i18nAriaLabel="label.targeting">
    <div class="preview-section" id={`${idPrefix}-targeting-section`}></div>
  </PopupBox>
</div>

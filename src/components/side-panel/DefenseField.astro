---
import PopupBox from "../popup/PopupBox.astro";
import TriggerButton from "../popup/TriggerButton.astro";

interface Props {
  readonly idPrefix: string;
}
const { idPrefix } = Astro.props;
---

<div class="form-field-group" id={`${idPrefix}-defense-field`}>
  <TriggerButton id={`${idPrefix}-defense-trigger`} popupId={`${idPrefix}-defense-popup`}
          labelI18n="label.defense" labelText="Defense"
          ariaLabelI18n="label.defense" ariaHaspopup="dialog" disabled
          ariaDescribedby={`${idPrefix}-defense-summary-row`}>
    <span class="trigger-summary" id={`${idPrefix}-defense-summary-row`}>
      <span id={`${idPrefix}-defense-summary`}></span>
    </span>
  </TriggerButton>
  <PopupBox id={`${idPrefix}-defense-popup`} extraClass="defense-popup popup-stretch" position="below" align="both" scroll role="dialog" ariaModal={false} i18nAriaLabel="label.defense">
    <div class="preview-section" id={`${idPrefix}-defense-section`}></div>
  </PopupBox>
</div>

---
interface Props {
  readonly id: string;
  readonly side: "ship-a" | "ship-b";
}
const { id, side } = Astro.props;
const portraitClass = `combatant-portrait combatant-portrait-${side}`;
const imageClass = `portrait-image portrait-image-${side}`;
---

<div id={id} class={portraitClass} hidden>
  <div class="portrait-image-wrap">
    <img class={imageClass} alt="">
    <div class={`portrait-lock-badge portrait-lock-badge-${side}`} hidden></div>
  </div>
  <div class={`portrait-hp-bars portrait-hp-bars-${side}`}>
    <div class="portrait-hp-row">
      <div class="portrait-hp-bar portrait-hp-bar-shield"><span class="portrait-hp-fill"></span></div>
      <span class="portrait-hp-value mono" data-defense-layer="shield" hidden></span>
    </div>
    <div class="portrait-hp-row">
      <div class="portrait-hp-bar portrait-hp-bar-armor"><span class="portrait-hp-fill"></span></div>
      <span class="portrait-hp-value mono" data-defense-layer="armor" hidden></span>
    </div>
    <div class="portrait-hp-row">
      <div class="portrait-hp-bar portrait-hp-bar-hull"><span class="portrait-hp-fill"></span></div>
      <span class="portrait-hp-value mono" data-defense-layer="hull" hidden></span>
    </div>
  </div>
  <div class="portrait-effects"></div>
</div>

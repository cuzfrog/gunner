---
import Icon from "../controls/Icon.astro";

interface Props {
  readonly version: string;
}
const { version } = Astro.props;
---

<header class="app-header">
  <div class="app-header-left">
    <h1 class="app-title">Gunner</h1>
    <span class="app-subtitle" data-i18n="app.subtitle">EVE Online 2D tactical simulator</span>
    <span class="app-version-text mono" id="app-version" data-i18n-aria-label="label.version" aria-label="Version">v{version}</span>
  </div>
  <div class="app-header-right">
    <nav class="app-lang-toggle" role="group" aria-label="Language" data-i18n-aria-label="label.language">
      <button type="button" id="lang-en" data-lang="en" class="btn" aria-pressed="true" data-i18n="lang.en">English</button>
      <button type="button" id="lang-zh" data-lang="zh" class="btn" aria-pressed="false" data-i18n="lang.zh">中文</button>
      <button type="button" id="lang-ja" data-lang="ja" class="btn" aria-pressed="false" data-i18n="lang.ja">日本語</button>
    </nav>
    <a class="app-github-link" href="https://github.com/cuzfrog/gunner" target="_blank" rel="noopener noreferrer"
       data-i18n-aria-label="label.github" data-i18n-title="label.github"
       aria-label="GitHub repository" title="GitHub repository">
      <Icon name="github" size={16} viewBox="0 0 16 16" class="app-github-icon" />
    </a>
  </div>
</header>

---
import Icon from "../controls/Icon.astro";

interface MechanismLink {
  readonly i18n: string;
  readonly text: string;
  readonly href: string;
}

interface Props {
  readonly accent: string;
  readonly headingI18n: string;
  readonly heading: string;
  readonly textI18n?: string;
  readonly text?: string;
  readonly links: readonly MechanismLink[];
}
const { accent, headingI18n, heading, textI18n, text, links } = Astro.props;
---

<div class="app-footer-mechanism" data-accent={accent}>
  <h3 class="footer-heading" data-i18n={headingI18n}>{heading}</h3>
  {text !== undefined && <p class="footer-text" data-i18n={textI18n}>{text}</p>}
  {links.map((link) => (
    <a class="app-footer-ref" href={link.href} target="_blank" rel="noopener noreferrer">
      <span data-i18n={link.i18n}>{link.text}</span>
      <Icon name="external" size={10} fill="none" stroke="currentColor" class="icon-ext" />
    </a>
  ))}
</div>

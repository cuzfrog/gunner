---
import Chevron from "../controls/Chevron.astro";

interface Props {
  readonly id: string;
  readonly popupId: string;
  readonly labelClass?: string;
  readonly labelI18n?: string;
  readonly labelText?: string;
  readonly hintI18n?: string;
  readonly ariaLabelI18n?: string;
  readonly hint?: string;
  readonly ariaLabel?: string;
  readonly ariaHaspopup?: string;
  readonly disabled?: boolean;
  readonly ariaDescribedby?: string;
}
const {
  id,
  popupId,
  labelClass = "trigger-label truncate",
  labelI18n,
  labelText,
  hintI18n,
  ariaLabelI18n,
  hint,
  ariaLabel,
  ariaHaspopup,
  disabled,
  ariaDescribedby,
} = Astro.props;
---

<button type="button" id={id} class="trigger"
  aria-haspopup={ariaHaspopup} aria-expanded="false" aria-controls={popupId}
  aria-describedby={ariaDescribedby} disabled={disabled}
  data-i18n-hint={hintI18n} data-i18n-aria-label={ariaLabelI18n}
  data-hint={hint} aria-label={ariaLabel}>
  {labelI18n || labelText ? <span class={labelClass} data-i18n={labelI18n}>{labelText}</span> : null}
  <slot />
  <Chevron />
</button>

---
import Icon from "../controls/Icon.astro";

interface Props {
  readonly id: string;
  readonly label: string;
  readonly i18nLabel: string;
  readonly labelClass: string;
  readonly ariaHaspopup?: string;
  readonly ariaExpanded?: boolean;
  readonly ariaControls?: string;
  readonly i18nTitle?: string;
  readonly i18nAriaLabel?: string;
  readonly title?: string;
  readonly ariaLabel?: string;
  readonly disabled?: boolean;
  readonly ariaDescribedby?: string;
  readonly chevronStroke?: string;
}

const { id, label, i18nLabel, labelClass, ariaHaspopup, ariaExpanded, ariaControls, i18nTitle, i18nAriaLabel, title, ariaLabel, disabled, ariaDescribedby, chevronStroke = "currentColor" } = Astro.props;
---

<button type="button" id={id} class="trigger"
  aria-haspopup={ariaHaspopup} aria-expanded={ariaExpanded} aria-controls={ariaControls}
  data-i18n-title={i18nTitle} data-i18n-aria-label={i18nAriaLabel}
  title={title} aria-label={ariaLabel}
  disabled={disabled} aria-describedby={ariaDescribedby}>
  <span class={`${labelClass} truncate`} data-i18n={i18nLabel}>{label}</span>
  <slot name="summary" />
  <Icon name="chevron" stroke={chevronStroke} />
</button>

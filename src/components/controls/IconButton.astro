---
import Icon from "./Icon.astro";

interface Props {
  readonly id: string;
  readonly icon: string;
  readonly title: string;
  readonly ariaLabel: string;
  readonly i18nTitle?: string;
  readonly i18nAriaLabel?: string;
  readonly class?: string;
  readonly disabled?: boolean;
  readonly ariaPressed?: boolean;
  readonly ariaHaspopup?: string;
  readonly ariaExpanded?: boolean;
  readonly ariaControls?: string;
  readonly dataValue?: string;
  readonly iconSize?: number;
  readonly iconFill?: string;
  readonly iconStroke?: string;
  readonly iconStrokeWidth?: number;
}
const { id, icon, title, ariaLabel, i18nTitle, i18nAriaLabel, class: className = "icon-button", disabled, ariaPressed, ariaHaspopup, ariaExpanded, ariaControls, dataValue, iconSize, iconFill, iconStroke, iconStrokeWidth } = Astro.props;
---

<button type="button" id={id} class={className}
  data-i18n-title={i18nTitle} data-i18n-aria-label={i18nAriaLabel}
  title={title} aria-label={ariaLabel}
  disabled={disabled} aria-pressed={ariaPressed}
  aria-haspopup={ariaHaspopup} aria-expanded={ariaExpanded} aria-controls={ariaControls}
  data-value={dataValue}>
  <Icon name={icon} size={iconSize} fill={iconFill} stroke={iconStroke} strokeWidth={iconStrokeWidth} />
</button>

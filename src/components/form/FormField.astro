---
interface Props {
  readonly label: string;
  readonly i18nLabel: string;
  readonly truncate?: boolean;
}
const { label, i18nLabel, truncate: isTruncate } = Astro.props;
---

<label class="form-field">
  <span class={`field-label${isTruncate ? " truncate" : ""}`} data-i18n={i18nLabel}>{label}</span>
  <slot />
</label>

---
interface Props {
  readonly fieldId: string;
  readonly label: string;
  readonly i18nLabel: string;
  readonly valueId: string;
  readonly sliderId: string;
  readonly hiddenId: string;
  readonly hiddenValue: string;
  readonly sliderValue: string;
  readonly fill: string;
  readonly i18nAriaLabel: string;
  readonly ariaLabel: string;
  readonly hintTitle: string;
  readonly hintI18nTitle: string;
  readonly hintI18nAriaLabel: string;
  readonly hintAriaLabel: string;
}
const { fieldId, label, i18nLabel, valueId, sliderId, hiddenId, hiddenValue, sliderValue, fill, i18nAriaLabel, ariaLabel, hintTitle, hintI18nTitle, hintI18nAriaLabel, hintAriaLabel } = Astro.props;
---

<div class="form-slider-field form-maneuver-field" id={fieldId}>
  <span class="form-slider-label-row">
    <span class="field-label truncate" data-i18n={i18nLabel}>{label}</span>
    <button type="button" class="info-hint"
      data-i18n-title={hintI18nTitle} data-i18n-aria-label={hintI18nAriaLabel}
      title={hintTitle} aria-label={hintAriaLabel}>?</button>
    <output class="form-slider-value mono" id={valueId} for={sliderId}>1.00</output>
  </span>
  <input type="hidden" id={hiddenId} value={hiddenValue} />
  <input type="range" id={sliderId} class="form-slider" min="0" max="1" step="0.001" value={sliderValue}
    style={`--fill: ${fill}`} data-i18n-aria-label={i18nAriaLabel} aria-label={ariaLabel} />
</div>

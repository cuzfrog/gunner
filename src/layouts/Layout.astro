---
import "../styles/styles.css";

interface Props {
  readonly title: string;
  readonly description?: string;
}
const DEFAULT_DESCRIPTION =
  "EVE Online combat simulator. Simulate ship-vs-ship fights in your browser with real-time movement, tracking, damage application and capacitor warfare.";
const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImageUrl = Astro.site ? new URL("/og-image.png", Astro.site).href : "/og-image.png";
const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Gunner",
  url: canonicalUrl,
  description,
  applicationCategory: "GameApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Gunner">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="2400">
  <meta property="og:image:height" content="1260">
  <meta property="og:image:alt" content="Gunner — EVE Online 2D combat simulator">
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} is:inline></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Saira:wght@400;500;600&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
</head>
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JFVYDV0Z8P"></script>
<script is:inline>
  if (location.hostname !== "localhost") {
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JFVYDV0Z8P');
    if (new URLSearchParams(location.search).has("c")) {
      gtag('event', 'deep_link_load');
    }
  }
</script>
<body>
  <slot />
  <noscript>
    <p>Gunner is a browser-based EVE Online 2D fight simulator. It simulates ship-vs-ship combat with real-time movement, turret tracking, damage application and capacitor warfare. Please enable JavaScript to run the simulator.</p>
  </noscript>
  <div id="hover-hint" class="hover-hint thin-scrollbar" role="tooltip" hidden></div>
  <script>
    import "../main";
  </script>
</body>
</html>
